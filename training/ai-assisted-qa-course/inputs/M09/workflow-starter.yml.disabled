name: AI QA course checks (starter)
on:
  pull_request:
permissions:
  contents: read
jobs:
  course-e2e:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Intentional defect: github.sha can identify the PR merge commit.
          ref: ${{ github.sha }}
      - uses: pnpm/action-setup@v4
        with:
          version: 10.34.5
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm run training:ai-assisted-qa:test
        env:
          PLAYWRIGHT_TEST_ROOT: workspace/M07
