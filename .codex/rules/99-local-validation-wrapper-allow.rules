# Codex on Windows routes tool commands through a pwsh -Command wrapper.
# These exact wrapper forms are loaded after the broad prompt rules so the
# Parent-defined validation set remains executable without widening shell use.

prefix_rule(
  pattern = ["pwsh", "-Command", "python", "scripts/validate-luna-orchestration.py"],
  decision = "allow",
  match = ["pwsh -Command python scripts/validate-luna-orchestration.py"],
)

prefix_rule(
  pattern = ["pwsh", "-Command", "bash", "scripts/verify"],
  decision = "allow",
  match = ["pwsh -Command bash scripts/verify"],
)

prefix_rule(
  pattern = ["pwsh", "-Command", "powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/verify.ps1"],
  decision = "allow",
  match = ["pwsh -Command powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"],
)

prefix_rule(
  pattern = ["pwsh", "-Command", "pnpm", "run", "test:contracts"],
  decision = "allow",
  match = ["pwsh -Command pnpm run test:contracts"],
)

# Current Windows tool routing can add -NoProfile before -Command. These
# forms remain exact allow rules for the same five Parent-defined commands.
prefix_rule(
  pattern = ["pwsh", "-NoProfile", "-Command", "python", "scripts/validate-luna-orchestration.py"],
  decision = "allow",
  match = ["pwsh -NoProfile -Command python scripts/validate-luna-orchestration.py"],
)

prefix_rule(
  pattern = ["pwsh", "-NoProfile", "-Command", "bash", "scripts/verify"],
  decision = "allow",
  match = ["pwsh -NoProfile -Command bash scripts/verify"],
)

prefix_rule(
  pattern = ["pwsh", "-NoProfile", "-Command", "powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/verify.ps1"],
  decision = "allow",
  match = ["pwsh -NoProfile -Command powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"],
)

prefix_rule(
  pattern = ["pwsh", "-NoProfile", "-Command", "pnpm", "run", "verify"],
  decision = "allow",
  match = ["pwsh -NoProfile -Command pnpm run verify"],
)

prefix_rule(
  pattern = ["pwsh", "-NoProfile", "-Command", "pnpm", "run", "test:contracts"],
  decision = "allow",
  match = ["pwsh -NoProfile -Command pnpm run test:contracts"],
)

# The Windows runtime may preserve the absolute host executable and the
# complete -Command payload as one token. Keep that observed form exact too.
prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "python scripts/validate-luna-orchestration.py"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "python scripts/validate-luna-orchestration.py"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "bash scripts/verify"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "bash scripts/verify"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "pnpm run test:contracts"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "pnpm run test:contracts"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "python scripts/validate-luna-orchestration.py"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "python scripts/validate-luna-orchestration.py"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "bash scripts/verify"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "bash scripts/verify"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "pnpm run verify"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "pnpm run verify"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "pnpm run test:contracts"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-NoProfile", "-Command", "pnpm run test:contracts"]],
)

# The shell router may retain single quotes around the -Command payload in
# the policy token. Permit only the observed five payloads in that form.
prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'python scripts/validate-luna-orchestration.py'"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'python scripts/validate-luna-orchestration.py'"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'bash scripts/verify'"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'bash scripts/verify'"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1'"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1'"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'pnpm run verify'"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'pnpm run verify'"]],
)

prefix_rule(
  pattern = ["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'pnpm run test:contracts'"],
  decision = "allow",
  match = [["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "'pnpm run test:contracts'"]],
)
