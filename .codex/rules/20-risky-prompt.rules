# Broad prompts for mutating or high-impact commands.

prefix_rule(
  pattern = ["git", ["checkout", "merge", "rebase", "tag"]],
  decision = "prompt",
  match = ["git checkout feature", "git merge main"],
)

prefix_rule(
  pattern = ["git", "branch", ["-d", "--delete", "-vd", "-dv"]],
  decision = "prompt",
  match = [
    "git branch -d old-feature",
    "git branch --delete old-feature",
    "git branch -vd old-feature",
    "git branch -dv old-feature",
  ],
)

prefix_rule(
  pattern = ["git", "branch", "-v", ["-d", "--delete"]],
  decision = "prompt",
  match = ["git branch -v -d old-feature", "git branch -v --delete old-feature"],
)

prefix_rule(
  pattern = ["gh", "api"],
  decision = "prompt",
  match = ["gh api /repos/example/repo/issues"],
)

prefix_rule(
  pattern = ["gh", "pr", ["merge", "close"]],
  decision = "prompt",
  match = ["gh pr merge 123", "gh pr close 123"],
)

prefix_rule(
  pattern = ["gh", "issue", "close"],
  decision = "prompt",
  match = ["gh issue close 123"],
)

prefix_rule(
  pattern = ["gh", "release", ["create", "delete"]],
  decision = "prompt",
  match = ["gh release create v1", "gh release delete v1"],
)

prefix_rule(
  pattern = ["gh", "repo", "delete"],
  decision = "prompt",
  match = ["gh repo delete example/repo"],
)

prefix_rule(
  pattern = [["chmod", "chown", "chgrp", "icacls", "takeown"]],
  decision = "prompt",
  match = ["chmod 644 file.txt", "icacls file.txt /grant Everyone:F"],
)

prefix_rule(
  pattern = [["kill", "pkill", "taskkill", "Stop-Service", "Restart-Service", "systemctl", "service"]],
  decision = "prompt",
  match = ["kill 1234", "systemctl stop nginx"],
)

prefix_rule(
  pattern = [["curl", "wget", "Invoke-WebRequest", "iwr", "Invoke-RestMethod", "irm"]],
  decision = "prompt",
  match = ["curl https://example.com", "Invoke-WebRequest https://example.com"],
)

prefix_rule(
  pattern = [["docker", "kubectl", "helm", "terraform", "aws", "az", "gcloud"]],
  decision = "prompt",
  match = ["docker ps", "kubectl get pods", "terraform plan"],
)

prefix_rule(
  pattern = [["crontab", "schtasks", "reg"]],
  decision = "prompt",
  match = ["crontab -l", "schtasks /query"],
)

prefix_rule(
  pattern = [["iptables", "nft", "ufw", "netsh", "route", "ip"]],
  decision = "prompt",
  match = ["ufw status", "netsh advfirewall show allprofiles"],
)

prefix_rule(
  pattern = [["bash", "sh"], ["-c", "-lc"]],
  decision = "prompt",
  match = ["bash -c echo test", "sh -c pwd"],
)

prefix_rule(
  pattern = [["pwsh", "pwsh.exe", "powershell", "powershell.exe"], ["-Command", "-c"]],
  decision = "prompt",
  match = ["pwsh -Command Get-Date", "powershell -Command Get-Date"],
)

prefix_rule(
  pattern = ["cmd", ["/c", "/k"]],
  decision = "prompt",
  match = ["cmd /c dir"],
)
