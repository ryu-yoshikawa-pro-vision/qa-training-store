# Defense-in-depth for the static destructive prefixes in the common Matrix.
# The Node PreToolUse Hook remains the Full Access policy source of truth.

prefix_rule(
  pattern = ["git", "reset", "--hard"],
  decision = "forbidden",
  match = ["git reset --hard HEAD~1"],
)

prefix_rule(
  pattern = ["git", "clean", ["-fd", "-fdx"]],
  decision = "forbidden",
  match = ["git clean -fd", "git clean -fdx"],
)

prefix_rule(
  pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
  decision = "forbidden",
  match = ["git push --force", "git push -f", "git push --force-with-lease"],
)

prefix_rule(
  pattern = ["git", "push", ["--delete", "--prune", "--mirror"]],
  decision = "forbidden",
  match = ["git push --delete origin old-feature", "git push --prune", "git push --mirror"],
)

prefix_rule(
  pattern = ["git", "branch", ["-f", "-D"]],
  decision = "forbidden",
  match = ["git branch -f feature", "git branch -D feature"],
)

prefix_rule(
  pattern = ["git", "tag", "-f"],
  decision = "forbidden",
  match = ["git tag -f release"],
)

prefix_rule(
  pattern = ["git", "stash", ["drop", "clear"]],
  decision = "forbidden",
  match = ["git stash drop stash@{0}", "git stash clear"],
)

prefix_rule(
  pattern = ["git", "rm"],
  decision = "forbidden",
  match = ["git rm file.txt"],
)

prefix_rule(
  pattern = [["rm", "del", "erase", "Remove-Item", "rmdir", "unlink"]],
  decision = "forbidden",
  match = [
    "rm file.txt",
    "del file.txt",
    "erase file.txt",
    "Remove-Item file.txt",
    "rmdir tmp",
    "unlink file.txt",
  ],
)

prefix_rule(
  pattern = ["docker", ["system", "volume", "network", "image"], "prune"],
  decision = "forbidden",
  match = ["docker system prune -a --volumes", "docker volume prune -f", "docker image prune -a"],
)

prefix_rule(
  pattern = ["kubectl", "delete"],
  decision = "forbidden",
  match = ["kubectl delete pod x"],
)

prefix_rule(
  pattern = ["helm", "uninstall"],
  decision = "forbidden",
  match = ["helm uninstall app"],
)

prefix_rule(
  pattern = ["terraform", "destroy"],
  decision = "forbidden",
  match = ["terraform destroy -auto-approve"],
)

prefix_rule(
  pattern = ["aws", "s3", "rm"],
  decision = "forbidden",
  match = ["aws s3 rm s3://bucket --recursive"],
)

prefix_rule(
  pattern = ["az", "group", "delete"],
  decision = "forbidden",
  match = ["az group delete -n rg-name -y"],
)

prefix_rule(
  pattern = ["gcloud", "projects", "delete"],
  decision = "forbidden",
  match = ["gcloud projects delete my-project"],
)

# These release/environment rules predate this Matrix and remain outside the
# Full Access common policy redesign, as specified by the remediation plan.
prefix_rule(
  pattern = ["npm", ["publish", "unpublish", "version"]],
  decision = "forbidden",
  match = ["npm publish", "npm unpublish package", "npm version patch"],
)

prefix_rule(
  pattern = [["pip", "pip3"], "uninstall"],
  decision = "forbidden",
  match = ["pip uninstall package"],
)

# Contains-style N2/N4 checks are intentionally left to the Node Hook because
# prefix rules cannot safely express rsync/robocopy/delete or remote piping.
