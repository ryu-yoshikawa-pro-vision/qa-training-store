# auto-net must stay non-interactive, so prompt-class high-impact operations are
# explicitly forbidden instead of falling through to allow when
# `20-risky-prompt.rules` is excluded.

prefix_rule(
  pattern = [["chmod", "chown", "chgrp", "icacls", "takeown"]],
  decision = "forbidden",
  match = ["chmod 644 file.txt", "icacls C:\\Temp /grant Everyone:F"],
)

prefix_rule(
  pattern = [["kill", "pkill", "taskkill", "Stop-Service", "Restart-Service", "systemctl", "service"]],
  decision = "forbidden",
  match = ["kill 1234", "systemctl stop nginx"],
)

prefix_rule(
  pattern = [["crontab", "schtasks", "reg"]],
  decision = "forbidden",
  match = ["crontab -e", "reg add HKCU\\Software\\Example"],
)

prefix_rule(
  pattern = [["iptables", "nft", "ufw", "netsh", "route", "ip"]],
  decision = "forbidden",
  match = ["iptables -L", "netsh advfirewall show allprofiles"],
)

prefix_rule(
  pattern = ["git", ["checkout", "switch", "merge", "rebase", "tag"]],
  decision = "forbidden",
  match = ["git checkout feature", "git rebase main"],
)

prefix_rule(
  pattern = ["git", "branch", ["-d", "--delete", "-vd", "-dv"]],
  decision = "forbidden",
  match = [
    "git branch -d old-feature",
    "git branch --delete old-feature",
    "git branch -vd old-feature",
    "git branch -dv old-feature",
  ],
)

prefix_rule(
  pattern = ["git", "branch", "-v", ["-d", "--delete"]],
  decision = "forbidden",
  match = ["git branch -v -d old-feature", "git branch -v --delete old-feature"],
)

prefix_rule(
  pattern = ["gh", "api"],
  decision = "forbidden",
  match = ["gh api /repos/example/repo/issues"],
)

prefix_rule(
  pattern = ["gh", "pr", ["merge", "close"]],
  decision = "forbidden",
  match = ["gh pr merge 123", "gh pr close 123"],
)

prefix_rule(
  pattern = ["gh", "issue", "close"],
  decision = "forbidden",
  match = ["gh issue close 123"],
)

prefix_rule(
  pattern = ["gh", "release", ["create", "delete"]],
  decision = "forbidden",
  match = ["gh release create v1", "gh release delete v1"],
)

prefix_rule(
  pattern = ["gh", "repo", "delete"],
  decision = "forbidden",
  match = ["gh repo delete example/repo"],
)
