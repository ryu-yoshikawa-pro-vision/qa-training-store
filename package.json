{
  "name": "scenario-shop",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "lint:markdown": "markdownlint-cli2",
    "lint": "eslint .",
    "typecheck:app": "tsc --noEmit --project tsconfig.json",
    "typecheck:native-tests": "tsc --noEmit --project tsconfig.native-tests.json",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:native-tests",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:repository": "vitest run tests/repository-contract",
    "test:component:web": "vitest run tests/component --exclude tests/component/native",
    "test:component:native": "jest --config jest.config.cjs",
    "test:component": "pnpm run test:component:web && pnpm run test:component:native",
    "test:contracts": "vitest run tests/contracts --no-file-parallelism --maxWorkers=1",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:repository && pnpm run test:component && pnpm run test:contracts",
    "test:e2e": "pnpm run test:e2e:chromium",
    "test:e2e:chromium": "playwright test e2e/web/phase1-required.spec.ts e2e/web/ui-ux-improvements.spec.ts --project=chromium",
    "test:a11y": "playwright test e2e/web/accessibility.spec.ts --project=chromium",
    "test:e2e:mobile": "playwright test e2e/web/phase1-required.spec.ts --project=mobile-chromium",
    "test:e2e:mobile-boundary": "playwright test e2e/web/mobile-boundary.spec.ts --project=mobile-chromium",
    "test:e2e:cross-role": "playwright test --project=cross-role-chromium",
    "test:e2e:smoke:firefox": "playwright test --project=firefox-smoke",
    "test:e2e:smoke:webkit": "playwright test --project=webkit-smoke",
    "test:smoke": "playwright test e2e/web/smoke.spec.ts --project=deployed-smoke",
    "security:check": "tsx scripts/security-static-check.ts",
    "validate:eas:config": "tsx scripts/validate-eas-static-config.ts",
    "validate:native-production-bundle": "tsx scripts/validate-native-production-bundle.ts",
    "check:native-route-dependencies": "tsx scripts/check-native-route-dependencies.ts",
    "prepare:font-assets": "tsx scripts/prepare-font-assets.ts",
    "generate:image-manifest": "tsx scripts/generate-image-manifest.ts",
    "generate:native-assets": "tsx scripts/generate-native-asset-map.ts",
    "validate:image-manifest": "tsx scripts/validate-image-manifest.ts",
    "build:web": "pnpm run prepare:font-assets && pnpm run generate:image-manifest && pnpm run validate:image-manifest && expo export --platform web",
    "build:native:android": "expo run:android",
    "build:native:android:release": "expo run:android --variant release",
    "build:native:ios": "expo run:ios",
    "build:native:ios:release": "expo run:ios --configuration Release",
    "native:android:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Doctor",
    "native:android:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Prepare",
    "native:android:build:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Build",
    "native:android:install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Install",
    "native:android:smoke:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Smoke",
    "native:android:test:control": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Test",
    "native:android:test:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action RuntimeSuite",
    "native:android:test:boundary": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action BoundarySuite",
    "native:android:evidence": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action Evidence",
    "native:android:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/windows/android-local.ps1 -Action All",
    "verify": "pnpm run format:check && pnpm run lint:markdown && pnpm run lint && pnpm run typecheck && pnpm run validate:image-manifest && pnpm run security:check && pnpm run test && pnpm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@hookform/resolvers": "5.5.7",
    "dexie": "4.4.4",
    "expo": "57.0.11",
    "expo-build-properties": "57.0.9",
    "expo-constants": "57.0.9",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.10",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.11",
    "expo-sqlite": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.3",
    "react-hook-form": "7.83.0",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.6",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.1",
    "fake-indexeddb": "6.2.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "jsdom": "29.1.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.8.1",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "expo-constants": "57.0.9"
    },
    "packageExtensions": {
      "@react-native/jest-preset@0.86.2": {
        "peerDependencies": {
          "react-native": "*"
        }
      }
    }
  }
}
